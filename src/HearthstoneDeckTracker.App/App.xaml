<Application x:Class="HearthstoneDeckTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#1B1E24"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#252830"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F4F8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA3B2"/>
        <SolidColorBrush x:Key="Accent" Color="#C9A227"/>
    </Application.Resources>
</Application>
