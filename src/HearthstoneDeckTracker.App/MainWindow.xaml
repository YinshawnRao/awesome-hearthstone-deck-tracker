<Window x:Class="HearthstoneDeckTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthstone Deck Tracker"
        Width="780"
        Height="860"
        MinWidth="640"
        MinHeight="640"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <DataTemplate x:Key="CardRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Width="32"
                       Height="32"
                       Stretch="UniformToFill"
                       Source="{Binding Thumbnail}"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding CostText}"
                           Foreground="{StaticResource Accent}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding DisplayName}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding CountText}"
                           Foreground="{StaticResource TextMuted}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="CardListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#1B1E24"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="ItemTemplate" Value="{StaticResource CardRowTemplate}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="ItemContainerStyle">
                <Style TargetType="ListBoxItem">
                    <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,2"/>
                </Style>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="Hearthstone Deck Tracker"/>
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,4,0,12"
                   Foreground="{StaticResource TextMuted}"
                   TextWrapping="Wrap"
                   Text="只读 Power.log。卡名/卡图来自 HearthstoneJSON zhCN，缓存在本地。不读内存、不注入、不抓包。"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="EnsureLogConfigButton"
                    Content="Ensure log.config"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="EnsureLogConfigButton_OnClick"/>
            <Button x:Name="ToggleOverlayButton"
                    Content="Show overlay stub"
                    Padding="12,6"
                    Click="ToggleOverlayButton_OnClick"/>
        </StackPanel>

        <Border Background="{StaticResource PanelBackground}" Padding="12" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="220"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource TextMuted}" Text="log.config"/>
                    <TextBox x:Name="LogConfigPathText"
                             Grid.Column="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource TextMuted}" Text="Power.log"/>
                    <TextBox x:Name="PowerLogPathText"
                             Grid.Column="1"
                             TextWrapping="Wrap"
                             ToolTip="Full path to Logs\\Power.log, or a fixture file. Leave unset to skip tailing."/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource TextMuted}" Text="Status"/>
                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               TextWrapping="Wrap"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource TextMuted}" Text="卡表"/>
                    <TextBlock x:Name="CatalogStatusText"
                               Grid.Column="1"
                               TextWrapping="Wrap"
                               Text="卡表加载中"/>
                </Grid>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <CheckBox x:Name="TailPowerLogCheck"
                              Content="Tail Power.log"
                              Foreground="{StaticResource TextPrimary}"
                              VerticalAlignment="Center"
                              Checked="TailPowerLogCheck_OnChanged"
                              Unchecked="TailPowerLogCheck_OnChanged"/>
                    <TextBlock Margin="16,0,0,0"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               Text="Reads the current file, then follows new lines."/>
                </StackPanel>

                <TextBlock x:Name="DeckSummaryText"
                           Grid.Row="5"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Text="Deck remaining —  waiting for Power.log"/>

                <Grid Grid.Row="6" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="套牌剩余"/>
                        <ListBox x:Name="DeckList" Style="{StaticResource CardListBox}"/>
                    </DockPanel>
                    <DockPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="手牌"/>
                        <ListBox x:Name="HandList" Style="{StaticResource CardListBox}"/>
                    </DockPanel>
                    <DockPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="已打出"/>
                        <ListBox x:Name="PlayedList" Style="{StaticResource CardListBox}"/>
                    </DockPanel>
                    <DockPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="对手可见"/>
                        <ListBox x:Name="OpponentList" Style="{StaticResource CardListBox}"/>
                    </DockPanel>
                </Grid>

                <DockPanel Grid.Row="7">
                    <TextBlock DockPanel.Dock="Top"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,6"
                               Text="最近事件"/>
                    <ListBox x:Name="EventList"
                             Background="#1B1E24"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="#3A3F4B"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
