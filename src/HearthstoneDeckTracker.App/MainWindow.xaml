<Window x:Class="HearthstoneDeckTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthstone Deck Tracker"
        Width="560"
        Height="640"
        MinWidth="460"
        MinHeight="480"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="Hearthstone Deck Tracker"/>
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,4,0,12"
                   Foreground="{StaticResource TextMuted}"
                   TextWrapping="Wrap"
                   Text="Read-only Power.log spike. No memory reading, injection, or packet sniffing. Draw/play tracking is a subset of the HearthSim game-state protocol."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="EnsureLogConfigButton"
                    Content="Ensure log.config"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="EnsureLogConfigButton_OnClick"/>
            <Button x:Name="ToggleOverlayButton"
                    Content="Show overlay stub"
                    Padding="12,6"
                    Click="ToggleOverlayButton_OnClick"/>
        </StackPanel>

        <Border Background="{StaticResource PanelBackground}" Padding="12" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextMuted}" Text="log.config" Margin="0,0,12,8"/>
                <TextBox x:Name="LogConfigPathText"
                         Grid.Row="0" Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,0,8"
                         TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextMuted}" Text="Power.log" Margin="0,0,12,8"/>
                <TextBox x:Name="PowerLogPathText"
                         Grid.Row="1" Grid.Column="1"
                         Margin="0,0,0,8"
                         TextWrapping="Wrap"
                         ToolTip="Full path to Logs\\Power.log, or a fixture file. Leave unset to skip tailing."/>

                <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextMuted}" Text="Status" Margin="0,0,12,8"/>
                <TextBlock x:Name="StatusText"
                           Grid.Row="2" Grid.Column="1"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <CheckBox x:Name="TailPowerLogCheck"
                              Content="Tail Power.log"
                              Foreground="{StaticResource TextPrimary}"
                              VerticalAlignment="Center"
                              Checked="TailPowerLogCheck_OnChanged"
                              Unchecked="TailPowerLogCheck_OnChanged"/>
                    <TextBlock Margin="16,0,0,0"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               Text="Reads the current file, then follows new lines."/>
                </StackPanel>

                <TextBlock x:Name="DeckSummaryText"
                           Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Text="Deck remaining —  waiting for Power.log"/>

                <DockPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock DockPanel.Dock="Top"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,6"
                               Text="Last events"/>
                    <ListBox x:Name="EventList"
                             Background="#1B1E24"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="#3A3F4B"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
